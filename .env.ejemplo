# Plantilla de configuración. Copiar a `.env` y completar.
#
#     cp .env.ejemplo .env
#
# El `.env` real nunca se versiona: está en .gitignore y contiene los secretos
# con los que se firman los tokens y se cifran las plantillas faciales.

# --- Base de datos -----------------------------------------------------------
# Con docker compose, DB_HOST lo fija el propio compose: acá se deja vacío.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marcacion
DB_USER=marcacion
DB_PASSWORD=

# --- Secretos ----------------------------------------------------------------
# Las tres son obligatorias y exigen 32 caracteres o más. Sin ellas el proceso
# aborta al arrancar, en lugar de firmar —o cifrar— con una clave que
# cualquiera puede leer en el repositorio.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
COMPROBANTE_CLAVE=

# Cifra las plantillas faciales en reposo (Ley 6534/2020). Generar con:
#   python -c "import sys; sys.path.insert(0,'src'); import biometria; print(biometria.generar_clave())"
#
# Guardala fuera del servidor. Si se pierde, las fotos registradas quedan
# ilegibles y hay que volver a tomarlas; si viaja junto al respaldo, un
# respaldo robado entrega los rostros de toda la plantilla.
BIOMETRIA_CLAVE=

# --- La empresa --------------------------------------------------------------
# Razón social con la que se crea la empresa en la primera migración.
EMPRESA_NOMBRE=Empresa

# Hora con la que se siembra el turno inicial. A partir de ahí los horarios se
# administran desde Gestión → Turnos, uno por cada horario real.
JORNADA_INICIO=08:00

# Empresa que atiende esta instalación cuando la base aloja a varias. Vacío
# con un solo cliente.
EMPRESA_ACTIVA=

# Dominio propio para resolver el cliente por subdominio (acme.miapp.com.py).
# Vacío con un solo cliente: contar etiquetas del host no sirve, porque
# miapp.com.py ya tiene tres sin tener ningún subdominio.
DOMINIO_BASE=

# --- Biometría ---------------------------------------------------------------
# Bloquea toda marca que el motor no pueda verificar. Viene apagada: una
# plantilla recién migrada no tiene fotos cargadas.
BIOMETRIA_OBLIGATORIA=0

# Pide un gesto al azar antes de aceptar la marca, para que una foto sostenida
# frente a la cámara no pase. Viene apagada porque cambia lo que la persona
# tiene que hacer para marcar.
BIOMETRIA_PRUEBA_VIDA=0

# --- Puestos de marcación ----------------------------------------------------
# Exige que cada marca venga de un kiosco dado de alta, con su token. Sin esto
# una marcación no registra desde dónde se hizo y "marqué desde casa" no se
# puede comprobar ni desmentir. Viene apagada: una instalación existente no
# tiene puestos dados de alta y encenderla de golpe deja a todos sin marcar.
DISPOSITIVO_OBLIGATORIO=0

# --- Opcionales --------------------------------------------------------------
PORT=8000

# Detalle del registro operativo, que sale por la salida estándar:
# DEBUG, INFO, WARNING, ERROR o CRITICAL. En INFO va una línea por petición.
LOG_NIVEL=INFO
DB_POOL_MIN=1
DB_POOL_MAX=10

# Avisos por correo. Sin SMTP_HOST no se envía nada y no falla nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
