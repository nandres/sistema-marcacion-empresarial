# Obsidian (bóveda interna: configuración local, nunca se sube)
.obsidian/
.trash/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Variables de entorno (credenciales - NUNCA subir)
.env
.env.local
.env.production
.env.*
# La plantilla sí va al repositorio: no tiene secretos, y sin ella quien
# clona de cero no tiene de dónde copiar el .env. La negación decía
# `.env.example`, en inglés, y el archivo se llama `.env.ejemplo`: no
# coincidía con nada y la plantilla nunca se subió.
!.env.ejemplo

# Reportes generados (datos de empleados)
reportes/

# Base de datos local
*.db
*.sqlite3

# Temporales y del sistema
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Editor
.idea/
.vscode/

# Empaquetado del kiosco
build/
dist/
